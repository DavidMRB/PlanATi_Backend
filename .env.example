APP_NAME=PlanATi API
APP_ENV=development
API_V1_PREFIX=/api/v1
# Genera una propia (también en local) con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# En producción la app no arranca con un valor por defecto o de menos de 43 caracteres.
SECRET_KEY=replace-with-a-local-secret
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
SMS_PROVIDER=mock
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
DATABASE_URL=postgresql+asyncpg://planati:planati@localhost:5433/planati
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET_NAME=planati-images
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# Seguridad de la sesión (CSRF y cookie)
# Orígenes aceptados en POST/PUT/PATCH/DELETE. Vacío = CORS_ORIGINS + FRONTEND_URL.
CSRF_TRUSTED_ORIGINS=
# En producción se fuerza a true
ACCESS_TOKEN_COOKIE_SECURE=false
ACCESS_TOKEN_COOKIE_SAMESITE=lax
# Solo si la API va en otro subdominio que el frontend (decisión D12). Vacío = sin atributo Domain.
ACCESS_TOKEN_COOKIE_DOMAIN=
# /docs, /redoc y /openapi.json. Vacío = activos en desarrollo y desactivados en producción.
ENABLE_API_DOCS=

# Zona horaria de la aplicación (horarios, recordatorios, límites diarios). Se guarda todo en UTC.
APP_TIMEZONE=America/Bogota

# Geolocalización y mapa
# sur,oeste,norte,este (Colombia continental + San Andrés). Vacío = sin restricción.
SERVICE_AREA_BOUNDS=-4.3,-81.8,13.6,-66.8
NEARBY_MAX_RADIUS_KM=50
MAP_MAX_MARKERS=500

# Puntuación y posicionamiento (puntuación bayesiana)
RANKING_MIN_REVIEWS=5
RANKING_PRIOR_MEAN=3.5
RELEVANCE_RATING_WEIGHT=0.6

# Reseñas, reportes y moderación
REVIEW_MAX_IMAGES=5
REVIEW_COMMENT_MAX_LENGTH=2000
REVIEWS_PER_DAY_LIMIT=10
REPORTS_PER_DAY_LIMIT=20
REPORT_AUTO_HIDE_THRESHOLD=0

# Planes y recordatorios
REMINDERS_ENABLED=true
REMINDER_POLL_SECONDS=60
PLAN_MIN_LEAD_MINUTES=15
PLAN_MAX_DAYS_AHEAD=365
PLAN_MAX_ACTIVE=50
PLAN_COMPLETE_AFTER_HOURS=3
PLAN_DEFAULT_DURATION_MINUTES=120
NOTIFICATIONS_RETENTION_DAYS=90

# Privacidad y datos personales (Ley 1581 de 2012)
PRIVACY_POLICY_VERSION=2026-11-01
TERMS_VERSION=2026-11-01
DATA_EXPORT_COOLDOWN_MINUTES=60

# Copias de seguridad locales (scripts/backup_db.py; no las usa la API)
BACKUP_DIR=backups
BACKUP_KEEP=10
BACKUP_DOCKER_CONTAINER=planati-postgres
